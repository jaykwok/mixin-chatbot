{
  "name": "mixin-chatbot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/server/index.ts",
    "dev": "bun --watch run src/server/index.ts",
    "configure": "bun run scripts/config/configure.ts",
    "configure-runtime": "bun run scripts/config/runtime-settings.ts",
    "relay": "bun run scripts/ops/relay-admin.ts",
    "routes": "bun run scripts/ops/route-admin.ts",
    "tmp": "bun run scripts/ops/tmp-admin.ts",
    "history": "bun run scripts/ops/history-admin.ts",
    "stat": "bun run scripts/ops/stats-admin.ts",
    "test": "bun run scripts/test.ts",
    "typecheck": "tsc --noEmit",
    "deadcode": "knip",
    "check": "bun run typecheck && bun run test && bun run deadcode && bun run deadcode --production"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "fs-extra": "11.4.0",
    "hono": "4.12.32",
    "marked": "18.0.5",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/fs-extra": "11.0.4",
    "@types/proper-lockfile": "4.1.4",
    "knip": "6.29.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "patchedDependencies": {
    "knip@6.29.0": "scripts/patches/knip@6.29.0.patch"
  }
}

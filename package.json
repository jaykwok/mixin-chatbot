{
  "name": "mixin-bot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "start": "bun run src/server/index.ts",
    "dev": "bun --watch run src/server/index.ts",
    "console": "bun run console/server/start.ts",
    "configure": "bun run ops/config/configure.ts",
    "configure-app-bot": "bun run ops/config/configure-app-bot.ts",
    "configure-runtime": "bun run ops/config/runtime-settings.ts",
    "relay": "bun run ops/tools/relay-admin.ts",
    "mcp": "bun run ops/tools/mcp-admin.ts",
    "tmp": "bun run ops/tools/tmp-admin.ts",
    "history": "bun run ops/tools/history-admin.ts",
    "stat": "bun run ops/tools/stats-admin.ts",
    "stat-import": "bun run ops/tools/stats-import.ts",
    "test": "bun run tests/run.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p console/ui && tsc --noEmit -p tests/console",
    "deadcode": "knip",
    "check": "bun run typecheck && bun run test && bun run deadcode && bun run deadcode --production"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-codemode": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-mcp": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "fs-extra": "11.4.0",
    "hono": "4.13.13",
    "marked": "18.0.5",
    "pptx-automizer": "0.9.3",
    "preact": "11.0.2",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@types/bun": "1.4.4",
    "@types/fs-extra": "11.0.4",
    "@types/proper-lockfile": "4.1.4",
    "knip": "6.40.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@types/node": "18.19.130",
    "brace-expansion": "5.0.12",
    "image-size": "2.0.4",
    "smol-toml": "1.9.0",
    "undici": "8.12.3",
    "zod": "4.6.6"
  },
  "patchedDependencies": {
    "knip@6.40.0": "patches/knip@6.40.0.patch"
  }
}

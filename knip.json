{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": true,
  "entry": [
    "src/server/index.ts!",
    "src/core/process-supervisor.ts!",
    "src/durable/sqlite-worker.ts!",
    "src/agent/modules/*/scripts/*.ts!",
    "scripts/config/{configure,configure-relay,runtime-settings,validate-models}.ts!",
    "scripts/ops/{*,tui/preview}.ts!",
    "scripts/runtime/*.ts!",
    "tests/**/*.test.ts",
    "tests/helpers/document-work-integration.ts",
    "tests/helpers/document-durable-integration.ts",
    "tests/helpers/document-office-integration.ts",
    "scripts/migrations/{run,validate}.ts!"
  ],
  "project": [
    "src/**/*.ts!",
    "scripts/{config,ops,lib,runtime,migrations}/**/*.ts!",
    "tests/**/*.ts"
  ]
}

{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": true,
  "entry": [
    "src/server/index.ts!",
    "src/lib/process-supervisor.ts!",
    "src/durable/sqlite-worker.ts!",
    "src/agent/modules/*/scripts/*.ts!",
    "ops/config/{configure,configure-relay,configuration-check,configuration-apply,configuration-install,directory-scope,directory-query,runtime-apply,runtime-settings,validate-models}.ts!",
    "console/server/{start,main,executor,read-cli}.ts!",
    "ops/core/check-plan.ts!",
    "ops/core/cli.ts!",
    "ops/core/{launchd-supervisor,macos-entry,macos-become}.ts!",
    "ops/lib/confirmed-transaction.ts!",
    "console/ui/src/main.tsx!",
    "ops/tools/*.ts!",
    "tests/**/*.test.{ts,tsx}",
    "tests/helpers/document-work-integration.ts",
    "tests/helpers/document-durable-integration.ts",
    "tests/helpers/document-office-integration.ts",
    "tests/helpers/console-ops-fixture.ts",
    "tests/helpers/console-task-racer.ts",
    "tests/helpers/console-screenshots.ts",
    "tests/helpers/console-screenshots-demo.ts"
  ],
  "project": [
    "src/**/*.ts!",
    "ops/**/*.ts!",
    "console/server/**/*.ts!",
    "console/ui/src/**/*.{ts,tsx}!",
    "tests/**/*.{ts,tsx}"
  ]
}
